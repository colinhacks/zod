{
  "private": true,
  "type": "module",
  "packageManager": "nub@0.8.3",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhacks/zod.git"
  },
  "bugs": {
    "url": "https://github.com/colinhacks/zod/issues"
  },
  "support": {
    "backing": {
      "npm-funding": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@biomejs/biome": "^1.9.4",
    "@seriousme/openapi-schema-validator": "2.9.0",
    "@types/benchmark": "^2.1.5",
    "@types/semver": "^7.7.0",
    "@web-std/file": "^3.0.3",
    "arktype": "^2.1.19",
    "benchmark": "^2.1.4",
    "chalk": "^5.4.1",
    "console-table-printer": "^2.12.1",
    "esbuild": "^0.25.5",
    "execa": "^9.5.2",
    "globby": "^16.2.0",
    "husky": "^9.1.7",
    "jsr": "^0.12.4",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "mitata": "^0.1.14",
    "prettier": "^3.5.3",
    "recheck": "4.6.0-beta.3",
    "rolldown": "1.0.0-beta.18",
    "rollup": "^4.60.2",
    "semver": "^7.7.2",
    "supershy": "^1.0.0",
    "tinybench": "^2.9.0",
    "ts-morph": "^28.0.0",
    "tsdown": "^0.21.10",
    "tslib": "^2.8.1",
    "typescript": "~5.5.4",
    "vite": "^7.3.6",
    "vitest": "^4.1.5",
    "zod": "workspace:*",
    "zod3": "npm:zod@~3.24.0",
    "zshy": "^0.8.0"
  },
  "lint-staged": {
    "packages/*/src/**/*.ts": [
      "biome format --no-errors-on-unmatched --write",
      "biome lint --no-errors-on-unmatched --write"
    ],
    "packages/*/**/*.json": [
      "biome format --no-errors-on-unmatched --write",
      "biome lint --no-errors-on-unmatched --write"
    ],
    "packages/*/**/*.md": [
      "prettier --ignore-unknown --write"
    ]
  },
  "scripts": {
    "fix": "nub run format && nub run lint",
    "format": "nub exec --node biome check --write .",
    "format:check": "nub exec --node biome check .",
    "lint": "nub exec --node biome lint --write .",
    "lint:check": "nub exec --node biome lint .",
    "clean": "nub run -r clean",
    "build": "nub run -r --filter zod --filter @zod/mini build",
    "test:watch": "nub exec --node vitest",
    "test": "nub exec --node vitest run",
    "test:compile": "nub exec --node vitest run --config vitest.compile.config.ts",
    "prepublishOnly": "nub run test && nub run build",
    "dev": "nub --conditions @zod/source",
    "dev:watch": "nub --conditions @zod/source --watch",
    "dev:play": "nub run dev play.ts",
    "bench": "nub --conditions @zod/source packages/bench/index.ts",
    "moltar": "nub run bench object-moltar",
    "prepare": "nub exec --node husky",
    "postbuild": "nub exec --node biome format --write .",
    "publish:jsr": "nub exec --node jsr publish --dry-run",
    "bundle:rollup": "nub exec --node rollup -c",
    "bundle:esbuild": "nub exec --node esbuild --bundle ./scratch/input.ts --outfile=./scratch/out_esbuild.js --bundle --format=esm",
    "check:semver": "nub scripts/check-versions.ts",
    "check:circular": "nub exec --node madge --circular --extensions ts --exclude '(v4/core|v3)' packages/zod/src",
    "check:comments": "nub scripts/check-comments.ts",
    "check:lockstep": "nub scripts/check-lockstep.ts",
    "update:iso4217": "nub scripts/update-iso-4217.ts"
  }
}
